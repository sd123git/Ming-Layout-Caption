        [
          {
            "x": 0,
            "y": 0,
            "width": 768,
            "height": 1024,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the whole picture reprinted as a mid-century screen-print poster sheet: flat unmodulated colour planes, hand-cut stencil edges, warm off-white paper stock with fine print grain, one faint ink misregistration, a thin dark-ink rule inset a few millimetres from the trimmed edge, no photographic depth of field",
              "palette": [
                "#f5f0e3",
                "#e4b23c",
                "#2f5fa8",
                "#1e2a38"
              ]
            }
          },
          {
            "x": 0,
            "y": 0,
            "width": 768,
            "height": 493,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the sunlit tiled facade redrawn as two flat ochre plates, one in full sun and one in shade, split by one crisp diagonal shadow that runs from the top edge near the centre down to the left edge about a fifth of the way down; the tile grout becomes a sparse regular grid of thin lighter lines",
              "palette": [
                "#e4b23c",
                "#c6952f",
                "#f0c85a"
              ]
            }
          },
          {
            "x": 49,
            "y": 182,
            "width": 165,
            "height": 311,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the left round-headed arch opening cut cleanly through the facade: inside it a flat pale-blue sky with one simplified cream cloud bank, edges stencil-cut, no gradients",
              "palette": [
                "#4e86c8",
                "#a9c9e8",
                "#f5f0e3"
              ]
            }
          },
          {
            "x": 306,
            "y": 171,
            "width": 168,
            "height": 323,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the centre arch opening, the tallest of the three: flat pale-blue sky, one low cream cloud shape near its base, and the daisy horizon showing as a thin band of small white dots across the bottom of the opening",
              "palette": [
                "#4e86c8",
                "#a9c9e8",
                "#f5f0e3"
              ]
            }
          },
          {
            "x": 559,
            "y": 178,
            "width": 174,
            "height": 316,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the right arch opening holding a single tree: trunk and crown reduced to a two-tone silhouette of dark olive green and deep umber against the pale blue sky, branches simplified to a few decisive lines, foliage as clustered flat shapes, no leaf texture",
              "palette": [
                "#4e86c8",
                "#6e8b4a",
                "#3b4a2e"
              ]
            }
          },
          {
            "x": 0,
            "y": 444,
            "width": 768,
            "height": 580,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "the daisy meadow drawn as poster shapes: the field as broad olive-green swathes rising to a soft ridge line, every daisy a simple white petal rosette with a flat ochre centre, evenly staggered and overlapping in loose rows, the nearest flowers large and crisp, the distant ones small pale dots",
              "palette": [
                "#8fa05a",
                "#b7c68a",
                "#f5f0e3",
                "#e4a62c"
              ]
            }
          },
          {
            "x": 298,
            "y": 432,
            "width": 146,
            "height": 78,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "an open parasol held high above her, seen from behind: the canopy a flat disc of deep rust-red silk with a black scalloped lace edge printed as a row of small half-circles and straight thin dark ribs radiating from the centre, a slim dark-wood shaft falling to her raised hand; the canopy tilted slightly to the left, one paler rust tone on its sunlit right half",
              "palette": [
                "#9e3b2e",
                "#6e2a22",
                "#1e2a38"
              ]
            }
          },
          {
            "x": 319,
            "y": 503,
            "width": 96,
            "height": 249,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "a graceful woman standing with her back to the camera, full length, drawn in the same flat screen-print language: a classical floor-length gown of deep rust-red silk, high waisted with one soft vertical fold falling from her shoulder blades to the hem, printed as two flat planes of rust separated by a single crisp fold line; her long hair gathered in a low classical chignon with a thin printed ribbon and two loose strands; bare shoulders and arms as flat warm-skin planes with one darker shadow tone along her right side; slim, tall and perfectly still, her weight on her left foot, one arm raised holding the parasol and the other relaxed at her side; her hem and feet disappearing into the daisies, the pressed grass in front of her printed as a few flat dark strokes",
              "palette": [
                "#9e3b2e",
                "#e8b893",
                "#1e2a38"
              ]
            }
          },
          {
            "x": 0,
            "y": 850,
            "width": 768,
            "height": 174,
            "metadata": {
              "type": "obj",
              "text": "",
              "desc": "a full-width band of warm cream paper across the foot of the poster, printed flat with a single thin ochre rule along its top edge and no texture, holding the typography with generous air between the lines",
              "palette": [
                "#f3eada",
                "#c6952f"
              ]
            }
          },
          {
            "x": 69,
            "y": 875,
            "width": 629,
            "height": 34,
            "metadata": {
              "type": "text",
              "text": "WHERE THE LIGHT LINGERS",
              "desc": "the title set in an elegant thin-stroke classical serif, all capitals with very wide letterspacing, ink navy, one line, centred in the band with generous air above and below; spelled exactly as written",
              "palette": [
                "#1e2a38"
              ]
            }
          },
          {
            "x": 115,
            "y": 926,
            "width": 538,
            "height": 21,
            "metadata": {
              "type": "text",
              "text": "a meadow, a parasol, an unhurried summer",
              "desc": "a single lower-case line in a small italic serif, ochre ink, wide letterspacing, centred, the commas kept; spelled exactly as written",
              "palette": [
                "#c6952f"
              ]
            }
          },
          {
            "x": 169,
            "y": 981,
            "width": 430,
            "height": 14,
            "metadata": {
              "type": "text",
              "text": "COMFY ORG",
              "desc": "a very small line of wide-tracked capitals in ink navy at the very foot of the band, centred; spelled exactly C O M F Y space O R G",
              "palette": [
                "#1e2a38"
              ]
            }
          }
        ],
        []
      ],
